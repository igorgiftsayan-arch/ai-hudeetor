# Public routing. Replace before rendering; this file contains no secrets.
APP_DOMAIN=app.example.invalid
PRODUCTION_COMPOSE_PROJECT_NAME=atlas-preproduction
PRODUCTION_GATEWAY_PORT=3200

# Runtime
APP_ENV=production
LOG_LEVEL=info
REQUEST_ID_HEADER=x-request-id
API_HOST=0.0.0.0
API_PORT=3001
API_CORS_ORIGIN=https://app.example.invalid
API_TRUST_PROXY_HOPS=2
NEXT_PUBLIC_API_BASE_URL=/api/v1
WEB_PORT=3000

# Identity
CSRF_SECRET=REQUIRED_SECRET
IDENTITY_ACCESS_TTL_SECONDS=900
IDENTITY_REFRESH_TTL_SECONDS=2592000
IDENTITY_SECURE_COOKIES=true
IDENTITY_TERMS_VERSION=terms-2026-10-01-v3
IDENTITY_PRIVACY_VERSION=privacy-2026-10-01-v3
IDENTITY_AI_WELLNESS_NOTICE_VERSION=REQUIRED_PUBLISHED_VERSION
IDENTITY_LOGIN_MAX_ATTEMPTS=5
IDENTITY_LOGIN_WINDOW_SECONDS=900
IDENTITY_REGISTRATION_MAX_ATTEMPTS=10
IDENTITY_REGISTRATION_WINDOW_SECONDS=3600
IDENTITY_EMAIL_PAYLOAD_SECRET=REQUIRED_SECRET
IDENTITY_EMAIL_VERIFICATION_TTL_SECONDS=86400
IDENTITY_PASSWORD_RESET_TTL_SECONDS=1800
IDENTITY_AI_PROVIDER_PROCESSING_VERSION=genapi-chat-food-2026-10-01-v2
IDENTITY_AI_PROVIDER_PROCESSING_DISCLOSURE="Внешний AI: GenAPI. Для чата передаются сообщения и необходимый контекст профиля, веса, памяти и подтверждённой еды. Для анализа выбранного фото передаются оригинальное изображение, цель по весу и сохранённые предпочтения, ограничения и цели. Фото и свободный текст могут содержать персональные данные; передача не является анонимной. AI может ошибаться и не заменяет врача. Подробности и сведения о получателях — в Политике конфиденциальности. Согласие разрешает эту обработку для чата и анализа фото; каждый запрос запускаете вы сами."

# PostgreSQL and Redis. Values must point to the private Compose network.
POSTGRES_DB=atlas
POSTGRES_USER=atlas
POSTGRES_PASSWORD=REQUIRED_SECRET
COMPOSE_DATABASE_URL=REQUIRED_SECRET
COMPOSE_REDIS_URL=redis://redis:6379/0

# Worker. Keep fake until the separate provider/consent release is approved.
WORKER_HEALTH_PORT=3002
WORKER_QUEUE_NAME=atlas-system
AI_PROVIDER=fake
AI_FAKE_MODE=success
GENAPI_API_KEY=
GENAPI_BASE_URL=
GENAPI_MODEL=
GENAPI_TIMEOUT_MS=60000
PUBLIC_WEB_URL=https://app.example.invalid
EMAIL_TRANSPORT=smtp
SMTP_HOST=smtp.jino.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=help@rebody38.ru
SMTP_PASSWORD=REQUIRED_SECRET
SMTP_FROM=help@rebody38.ru

# Existing private food-photo storage, on the same host. Not a backup service.
# Supply protected runtime credentials before enabling compose.production-food.
FOOD_STORAGE_ACCESS_KEY=REQUIRED_SECRET
FOOD_STORAGE_SECRET_KEY=REQUIRED_SECRET
FOOD_VISION_PROVIDER=fake
GENAPI_NATIVE_BASE_URL=https://api.gen-api.ru/api/v1
GENAPI_VISION_MODEL=gpt-4o
GENAPI_VISION_MODEL_VERSION=gpt-4o-2024-08-06
# For the optional offline source-build overlay only; validate binary hashes.
FOOD_STORAGE_BIN_DIR=REQUIRED_VERIFIED_DIRECTORY
MARATHON_BOOTSTRAP_ENABLED=false
MARATHON_BOOTSTRAP_USER_IDS=
PUSH_ENABLED=false
PUSH_VAPID_SUBJECT=
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
