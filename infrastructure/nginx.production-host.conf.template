limit_req_zone $binary_remote_addr zone=atlas_signup:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=atlas_auth:10m rate=20r/m;

server {
  listen 80;
  listen [::]:80;
  server_name ${APP_DOMAIN};
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name ${APP_DOMAIN};

  ssl_certificate /etc/letsencrypt/live/${APP_DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${APP_DOMAIN}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;

  client_max_body_size 1m;

  location = /api/v1/registrations {
    limit_req zone=atlas_signup burst=3 nodelay;
    limit_req_status 429;
    proxy_pass http://127.0.0.1:${PRODUCTION_GATEWAY_PORT};
    include proxy_params;
    proxy_set_header X-Forwarded-Proto https;
  }

  location = /api/v1/sessions {
    limit_req zone=atlas_auth burst=5 nodelay;
    limit_req_status 429;
    proxy_pass http://127.0.0.1:${PRODUCTION_GATEWAY_PORT};
    include proxy_params;
    proxy_set_header X-Forwarded-Proto https;
  }

  location / {
    proxy_pass http://127.0.0.1:${PRODUCTION_GATEWAY_PORT};
    include proxy_params;
    proxy_set_header X-Forwarded-Proto https;
  }
}
