server {
  listen 80;
  listen [::]:80;
  server_name ${LEGAL_DOMAIN};
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name ${LEGAL_DOMAIN};

  ssl_certificate /etc/letsencrypt/live/${LEGAL_DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${LEGAL_DOMAIN}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;

  location = /terms {
    proxy_pass http://127.0.0.1:${PRODUCTION_GATEWAY_PORT};
    include proxy_params;
    proxy_set_header X-Forwarded-Proto https;
  }

  location = /terms/ {
    proxy_pass http://127.0.0.1:${PRODUCTION_GATEWAY_PORT};
    include proxy_params;
    proxy_set_header X-Forwarded-Proto https;
  }

  location = /privacy {
    proxy_pass http://127.0.0.1:${PRODUCTION_GATEWAY_PORT};
    include proxy_params;
    proxy_set_header X-Forwarded-Proto https;
  }

  location = /privacy/ {
    proxy_pass http://127.0.0.1:${PRODUCTION_GATEWAY_PORT};
    include proxy_params;
    proxy_set_header X-Forwarded-Proto https;
  }

  location ^~ /_next/ {
    proxy_pass http://127.0.0.1:${PRODUCTION_GATEWAY_PORT};
    include proxy_params;
    proxy_set_header X-Forwarded-Proto https;
  }

  location / {
    return 404;
  }
}
