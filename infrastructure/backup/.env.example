# Store the real file outside the repository, owned by root with mode 600.
# This template contains names and non-secret examples only.
RESTIC_REPOSITORY=s3:https://s3.example.invalid/private-bucket/rebody38-production/postgresql
RESTIC_PASSWORD=replace_with_a_distinct_backup_encryption_secret
AWS_ACCESS_KEY_ID=replace_with_scoped_backup_access_key
AWS_SECRET_ACCESS_KEY=replace_with_scoped_backup_secret_key
AWS_DEFAULT_REGION=replace_with_storage_region

BACKUP_REPOSITORY_PREFIX=rebody38-production/postgresql
BACKUP_POSTGRES_CONTAINER=atlas-rebody38-production-postgres-1
BACKUP_POSTGRES_USER=atlas
BACKUP_POSTGRES_DATABASE=atlas
BACKUP_SCOPE_HOST=atlas-rebody38-production
BACKUP_SCOPE_TAG=rebody38-production-postgresql
BACKUP_STATE_DIR=/var/lib/rebody38-backup
BACKUP_STATUS_FILE=/var/lib/rebody38-backup/status.json

# Pin reviewed tooling; do not replace this with latest.
RESTIC_IMAGE=restic/restic@sha256:08916bcda4a4435f9d9828ebb4e91bb7ada3d2c8a53699788930e0ae1bd4fa67
