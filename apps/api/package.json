{
  "name": "@atlas/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @atlas/backend build && nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "openapi:export": "tsx src/openapi/export-openapi.ts"
  },
  "dependencies": {
    "@atlas/backend": "workspace:*",
    "@nestjs/common": "11.1.17",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.17",
    "@nestjs/platform-express": "11.1.17",
    "@nestjs/swagger": "11.4.6",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.0.4"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.16",
    "@nestjs/testing": "11.1.17",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/supertest": "7.2.1",
    "jest": "30.4.2",
    "supertest": "7.2.2",
    "ts-jest": "29.4.11",
    "tsx": "4.23.1"
  }
}
