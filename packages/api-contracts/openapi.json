  "info": {
    "title": "ATLAS API",
    "description": "",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "ConsentAcceptanceDto": {
        "type": "object",
        "properties": {
          "consentType": {
            "type": "string",
            "enum": [
              "terms",
              "privacy"
            ]
          },
          "documentVersion": {
            "type": "string",
            "example": "v1"
          },
          "accepted": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        },
        "required": [
          "consentType",
          "documentVersion",
          "accepted"
        ]
      },
      "RegistrationRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "person@example.com",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128,
            "writeOnly": true
          },
          "ageConfirmed": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "consents": {
            "minItems": 2,
            "maxItems": 2,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConsentAcceptanceDto"
            }
          }
        },
        "required": [
          "email",
          "password",
          "ageConfirmed",
          "consents"
        ]
      },
      "RegistrationResourceDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "onboardingStatus": {
            "type": "string",
            "enum": [
              "registered",
              "profileReady",
              "personaReady",
              "completed"
            ]
          },
          "sessionExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "csrfToken": {
            "type": "string"
          }
        },
        "required": [
          "userId",
          "onboardingStatus",
          "sessionExpiresAt",
          "csrfToken"
        ]
      },
      "CreateSessionRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "person@example.com",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "SessionResourceDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "onboardingStatus": {
            "type": "string",
            "enum": [
              "registered",
              "profileReady",
              "personaReady",
              "completed"
            ]
          },
          "csrfToken": {
            "type": "string"
          }
        },
        "required": [
          "userId",
          "expiresAt",
          "onboardingStatus",
          "csrfToken"
        ]
      },
      "CurrentUserResourceDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "onboardingStatus": {
            "type": "string",
            "enum": [
              "registered",
              "profileReady",
              "personaReady",
              "completed"
            ]
          }
        },
        "required": [
          "userId",
          "onboardingStatus"
        ]
      },
      "AiActionPriceResourceDto": {
        "type": "object",
        "properties": {
          "actionType": {
            "type": "string",
            "enum": [
              "quickReply"
            ]
          },
          "priceTokens": {
            "type": "number",
            "example": 1
          },
          "priceVersion": {
            "type": "number",
            "example": 1
          }
        },
        "required": [
          "actionType",
          "priceTokens",
          "priceVersion"
        ]
      },
      "AiConversationMessageResourceDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "role",
          "content",
          "createdAt"
        ]
      },
      "AiConversationDetailResourceDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AiConversationMessageResourceDto"
            }
          }
        },
        "required": [
          "id",
          "messages"
        ]
      },
      "AiConversationResourceDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "id"
        ]
      },
      "StartQuickReplyRequestDto": {
        "type": "object",
        "properties": {
          "conversationId": {
            "type": "string",
            "format": "uuid"
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "scenarioId": {
            "type": "string",
            "enum": [
              "quickReply"
            ]
          },
          "expectedPriceTokens": {
            "type": "number",
            "example": 1
          },
          "priceVersion": {
            "type": "number",
            "example": 1
          }
        },
        "required": [
          "conversationId",
          "content",
          "scenarioId",
          "expectedPriceTokens",
          "priceVersion"
        ]
      },
      "AiOperationResourceDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "processing",
              "succeeded",
              "technicalError",
              "outcomeUnknown"
            ]
          },
          "conversationId": {
            "type": "string",
            "format": "uuid"
          },
          "inputMessageId": {
            "type": "string",
            "format": "uuid"
          },
          "reservedTokens": {
            "type": "number"
          },
          "priceVersion": {
            "type": "number"
          },
          "pollUrl": {
            "type": "string"
          },
          "runtimeAdapter": {
            "type": "string",
            "enum": [
              "fake"
            ]
          },
          "outputMessageId": {
            "type": "string",
            "format": "uuid"
          },
          "responseText": {
            "type": "string"
          },
          "errorCode": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "conversationId",
          "inputMessageId",
          "reservedTokens",
          "priceVersion",
          "pollUrl",
          "runtimeAdapter"
        ]
      },
      "UserProfileResourceDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "timezone": {
            "type": "string"
          },
          "onboardingStatus": {
            "type": "string",
            "enum": [
              "registered",
              "profileReady",
              "personaReady",
              "completed"
            ]
          }
        },
        "required": [
          "userId",
          "timezone",
          "onboardingStatus"
        ]
      },
      "AiPreferenceResourceDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "personaId": {
            "type": "string",
            "enum": [
              "gentleFriend",
              "strictCoach",
              "russianLuli",
              "glamorousFriend",
              "analyst"
            ]
          },
          "strictness": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "responseLength": {
            "type": "string",
            "enum": [
              "short",
              "medium",
              "long"
            ]
          },
          "onboardingStatus": {
            "type": "string",
            "enum": [
              "registered",
              "profileReady",
              "personaReady",
              "completed"
            ]
          }
        },
        "required": [
          "userId",
          "personaId",
          "strictness",
          "responseLength",
          "onboardingStatus"
        ]
      },
      "OnboardingResourceDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "registered",
              "profileReady",
              "personaReady",
              "completed"
            ]
          },
          "completedSteps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requiredSteps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "canComplete": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "aiWellnessNoticeVersion": {
            "type": "string"
          },
          "csrfToken": {
            "type": "string"
          },
          "profile": {
            "$ref": "#/components/schemas/UserProfileResourceDto"
          },
          "aiPreference": {
            "$ref": "#/components/schemas/AiPreferenceResourceDto"
          }
        },
        "required": [
          "status",
          "completedSteps",
          "requiredSteps",
          "canComplete",
          "aiWellnessNoticeVersion",
          "csrfToken"
        ]
      },
      "WellnessNoticeConsentDto": {
        "type": "object",
        "properties": {
          "consentType": {
            "type": "string",
            "enum": [
              "aiWellnessNotice"
            ]
          },
          "documentVersion": {
            "type": "string",
            "example": "test-v1"
          },
          "accepted": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        },
        "required": [
          "consentType",
          "documentVersion",
          "accepted"
        ]
      },
      "UpdateProfileRequestDto": {
        "type": "object",
        "properties": {
          "timezone": {
            "type": "string",
            "example": "Asia/Irkutsk",
            "maxLength": 64
          },
          "consents": {
            "maxItems": 1,
            "type": "array",
