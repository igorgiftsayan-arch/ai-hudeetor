# Shared runtime
APP_ENV=local
LOG_LEVEL=info
REQUEST_ID_HEADER=x-request-id

# Web (public values only)
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
# Public document versions must exactly match IDENTITY_* below. They are required
# for the browser to submit explicit registration consent; they are not secrets.
NEXT_PUBLIC_IDENTITY_TERMS_VERSION=test-v1
NEXT_PUBLIC_IDENTITY_PRIVACY_VERSION=test-v1

# API
API_HOST=0.0.0.0
API_PORT=3001
API_TRUST_PROXY_HOPS=0
API_CORS_ORIGIN=http://localhost:3000
CSRF_SECRET=replace_with_at_least_32_random_characters
IDENTITY_ACCESS_TTL_SECONDS=900
IDENTITY_REFRESH_TTL_SECONDS=2592000
IDENTITY_SECURE_COOKIES=false
IDENTITY_TERMS_VERSION=test-v1
IDENTITY_PRIVACY_VERSION=test-v1
IDENTITY_AI_WELLNESS_NOTICE_VERSION=test-v1
IDENTITY_AI_PROVIDER_PROCESSING_VERSION=test-v1
IDENTITY_AI_PROVIDER_PROCESSING_DISCLOSURE=AI requests are processed by an external provider under the current privacy notice.
IDENTITY_LOGIN_MAX_ATTEMPTS=5
IDENTITY_LOGIN_WINDOW_SECONDS=900
IDENTITY_REGISTRATION_MAX_ATTEMPTS=10
IDENTITY_REGISTRATION_WINDOW_SECONDS=3600
IDENTITY_EMAIL_PAYLOAD_SECRET=replace_with_a_distinct_32_character_secret
IDENTITY_EMAIL_VERIFICATION_TTL_SECONDS=86400
IDENTITY_PASSWORD_RESET_TTL_SECONDS=1800

# Worker
WORKER_HEALTH_PORT=3002
WORKER_QUEUE_NAME=atlas-system
AI_PROVIDER=fake
AI_FAKE_MODE=success
PUBLIC_WEB_URL=http://localhost:3000
EMAIL_TRANSPORT=fake
# Required only when EMAIL_TRANSPORT=smtp. Never commit real values.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Required only when AI_PROVIDER=genapi. Never commit real values.
GENAPI_API_KEY=
GENAPI_BASE_URL=
GENAPI_MODEL=
GENAPI_TIMEOUT_MS=60000

# PostgreSQL
POSTGRES_DB=atlas
POSTGRES_USER=atlas
POSTGRES_PASSWORD=change_me_local_only
DATABASE_URL=postgresql://atlas:change_me_local_only@localhost:5432/atlas

# Redis
REDIS_URL=redis://localhost:6379/0
