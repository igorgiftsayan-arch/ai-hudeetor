# Shared runtime
APP_ENV=local
LOG_LEVEL=info
REQUEST_ID_HEADER=x-request-id

# Web (public values only)
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# API
API_HOST=0.0.0.0
API_PORT=3001
API_CORS_ORIGIN=http://localhost:3000
CSRF_SECRET=replace_with_at_least_32_random_characters
IDENTITY_ACCESS_TTL_SECONDS=900
IDENTITY_REFRESH_TTL_SECONDS=2592000
IDENTITY_SECURE_COOKIES=false
IDENTITY_TERMS_VERSION=test-v1
IDENTITY_PRIVACY_VERSION=test-v1
IDENTITY_AI_WELLNESS_NOTICE_VERSION=test-v1
IDENTITY_LOGIN_MAX_ATTEMPTS=5
IDENTITY_LOGIN_WINDOW_SECONDS=900

# Worker
WORKER_HEALTH_PORT=3002
WORKER_QUEUE_NAME=atlas-system
AI_PROVIDER=fake
AI_FAKE_MODE=success

# PostgreSQL
POSTGRES_DB=atlas
POSTGRES_USER=atlas
POSTGRES_PASSWORD=change_me_local_only
DATABASE_URL=postgresql://atlas:change_me_local_only@localhost:5432/atlas

# Redis
REDIS_URL=redis://localhost:6379/0
