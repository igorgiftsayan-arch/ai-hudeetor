# Runtime
APP_ENV=test
APP_BASE_URL=https://test.example.invalid
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgresql://app_user:change_me@postgres:5432/app_db

# Redis
REDIS_URL=redis://redis:6379/0

# S3-compatible storage
S3_ENDPOINT=https://s3.example.invalid
S3_REGION=example-region
S3_BUCKET=app-test
S3_ACCESS_KEY_ID=change_me
S3_SECRET_ACCESS_KEY=change_me

# Security and sessions
SESSION_SECRET=change_me

# AI integration (provider is intentionally undecided)
AI_PROVIDER=
AI_API_KEY=

# Analytics and payments (vendors are intentionally undecided)
ANALYTICS_ENDPOINT=
ANALYTICS_WRITE_KEY=
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=
